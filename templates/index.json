        "liquid": "<style>\n  .jade-ingredients-slider {\n    background: #fff;\n    padding: 35px 0 40px;\n    overflow: hidden;\n    width: 100%;\n  }\n\n  .jade-ingredients-title {\n    text-align: center;\n    margin-bottom: 28px;\n    padding: 0 20px;\n  }\n\n  .jade-ingredients-title h2 {\n    margin: 0 0 8px;\n    color: #3F4A2E;\n    font-size: 28px;\n    font-weight: 600;\n  }\n\n  .jade-ingredients-title p {\n    margin: 0 auto;\n    max-width: 650px;\n    color: #666;\n    font-size: 14px;\n    line-height: 1.5;\n  }\n\n  .jade-slider-window {\n    width: 100%;\n    overflow: hidden;\n  }\n\n  .jade-slider-track {\n    display: flex;\n    width: max-content;\n    gap: 22px;\n    animation: jade-scroll 35s linear infinite;\n    will-change: transform;\n  }\n\n  .jade-ingredient {\n    width: 150px;\n    flex: 0 0 150px;\n    text-align: center;\n  }\n\n  .jade-ingredient img {\n    width: 150px;\n    height: 150px;\n    object-fit: cover;\n    border-radius: 18px;\n    display: block;\n    box-shadow: 0 2px 8px rgba(0,0,0,.06);\n  }\n\n  .jade-ingredient-name {\n    margin-top: 10px;\n    color: #3F4A2E;\n    font-family: Poppins, sans-serif;\n    font-size: 14px;\n    font-weight: 600;\n    line-height: 1.3;\n  }\n\n  .jade-ingredient-benefit {\n    margin-top: 5px;\n    color: #777;\n    font-size: 11px;\n    line-height: 1.4;\n  }\n\n  @keyframes jade-scroll {\n    from {\n      transform: translateX(0);\n    }\n\n    to {\n      transform: translateX(calc(-50% - 11px));\n    }\n  }\n\n  /* Deuxième copie uniquement pour permettre la boucle parfaitement continue.\n     Elle n'est jamais visible simultanément comme un doublon fixe. */\n  .jade-slider-group {\n    display: flex;\n    gap: 22px;\n    padding-right: 22px;\n  }\n\n  .jade-slider-track:hover {\n    animation-play-state: paused;\n  }\n\n  @media (max-width: 768px) {\n\n    .jade-ingredients-slider {\n      padding: 28px 0 32px;\n    }\n\n    .jade-ingredients-title h2 {\n      font-size: 23px;