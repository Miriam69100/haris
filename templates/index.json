is\">\n          <div class=\"jade-ingredient-name\">Camellia Sinensis</div>\n          <div class=\"jade-ingredient-benefit\">Riche en antioxydants</div>\n        </div>\n\n        <!-- Reishi Noir -->\n        <div class=\"jade-ingredient\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0909/0590/3477/files/ChatGPT_Image_9_janv._2026_00_28_25.png?v=1767915553\" alt=\"Reishi Noir\">\n          <div class=\"jade-ingredient-name\">Reishi Noir</div>\n          <div class=\"jade-ingredient-benefit\">Revitalise la chevelure</div>\n        </div>\n\n        <!-- Noix de Savon -->\n        <div class=\"jade-ingredient\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0909/0590/3477/files/ChatGPT_Image_9_janv._2026_00_27_47.png?v=1767915538\" alt=\"Noix de Savon\">\n          <div class=\"jade-ingredient-name\">Noix de Savon</div>\n          <div class=\"jade-ingredient-benefit\">Nettoie en douceur</div>\n        </div>\n\n        <!-- Beurre de Karité -->\n        <div class=\"jade-ingredient\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0909/0590/3477/files/ChatGPT_Image_9_janv._2026_00_27_51.png?v=1767915545\" alt=\"Beurre de Karité\">\n          <div class=\"jade-ingredient-name\">Beurre de Karité</div>\n          <div class=\"jade-ingredient-benefit\">Nourrit la fibre</div>\n        </div>\n\n        <!-- Vitamine B5 -->\n        <div class=\"jade-ingredient\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0909/0590/3477/files/ChatGPT_Image_9_janv._2026_00_27_35.png?v=1767915545\" alt=\"Vitamine B5\">\n          <div class=\"jade-ingredient-name\">Vitamine B5</div>\n          <div class=\"jade-ingredient-benefit\">Adoucit et conditionne</div>\n        </div>\n\n        <!-- Fleurs d'Osmanthus -->\n        <div class=\"jade-ingredient\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0909/0590/3477/files/ChatGPT_Image_9_janv._2026_00_28_32.png?v=1767915531\" alt=\"Fleurs d'Osmanthus\">\n          <div class=\"jade-ingr