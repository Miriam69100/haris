   gap: 11px; \n    padding: 9px 10px; \n    font-size: 13px; \n  } \n \n  .viewers-icon-luxury { \n    width: 49px; \n    height: 18px; \n  } \n} \n</style>\n\n<script>\n(function() {\n  const viewer = document.getElementById(\"viewer-count-luxury-2024\");\n\n  if (!viewer) return;\n\n  let currentCount = 77;\n\n  // Nombre minimum et maximum de visiteurs\n  const MIN_VIEWERS = 65;\n  const MAX_VIEWERS = 120;\n\n  function updateViewers() {\n    // Variation légère : -3 à +5 personnes\n    const variation = Math.floor(Math.random() * 9) - 3;\n\n    let newCount = currentCount + variation;\n\n    // Empêche de sortir de la plage\n    if (newCount < MIN_VIEWERS) newCount = MIN_VIEWERS;\n    if (newCount > MAX_VIEWERS) newCount = MAX_VIEWERS;\n\n    currentCount = newCount;\n\n    // Petit effet de transition\n    viewer.style.opacity = \"0\";\n\n    setTimeout(() => {\n      viewer.textContent = currentCount;\n      viewer.style.opacity = \"1\";\n    }, 250);\n  }\n\n  // Change toutes les 8 à 15 secondes\n  function scheduleUpdate() {\n    const delay = Math.floor(Math.random() * 7000) + 8000;\n\n    setTimeout(() => {\n      updateViewers();\n      scheduleUpdate();\n    }, delay);\n  }\n\n  scheduleUpdate();\n})();\n</script>"
